{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/cv-library-3-slots": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/night-flight",
      "schedule": "0 0 * * *"
