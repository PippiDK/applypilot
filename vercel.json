{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/cv-library-3-slots": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/night-flight",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/night-flight",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/night-flight-worker",
      "schedule": "35 9 * * *"
    },
    {
      "path": "/api/cron/night-flight-worker",
      "schedule": "40 9 * * *"
    },
    {
      "path": "/api/cron/night-flight-worker",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/api/cron/night-flight-worker",
      "schedule": "50 9 * * *"
    },
    {
      "path": "/api/cron/night-flight-worker",
      "schedule": "55 9 * * *"
    },
    {
      "path": "/api/cron/night-flight-worker",
      "schedule": "59 9 * * *"
    }
  ]
}
